# frozen_string_literal: true

source "https://rubygems.org"

# Specify your gem's dependencies in robot_lab-discovery.gemspec
gemspec

gem 'robot_lab', path: '../robot_lab'

gem "irb"
gem "rake", "~> 13.0"

group :development, :test do
  gem "flay"
  gem "flog"
  gem "reek"
  gem "rubocop"
end

group :test do
  gem "minitest", "~> 5.16"
  gem "minitest-reporters"
  gem "simplecov", require: false
end
